{
    "name": "hoanguyencoder/http-status",
    "description": "HTTP status code helper for PHP",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "http",
        "status",
        "http-status",
        "php"
    ],
    "authors": [
        {
            "name": "Hoa Nguyen Coder",
            "email": "nguyen.thanh.hoa.ctec@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Hoanguyencoder\\HttpStatus\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hoanguyencoder\\HttpStatus\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "support": {
        "source": "https://github.com/skipperhoa/http-status"
    }
}
